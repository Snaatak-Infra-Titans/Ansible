extends: default

rules:
  # Relax long line rule: allow up to 140 chars, only warn
  line-length:
    max: 140
    level: warning

  # Disable trailing spaces rule
  trailing-spaces: disable

  # Optional: keep indentation rule but simpler
  indentation:
    indent-sequences: consistent

  # Optional: no need for "---" at start of file
  document-start: disable
