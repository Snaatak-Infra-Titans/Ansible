@Library('ansible-playbook-ci-shared-library') _

pipeline {
    agent any

    stages {

        stage('Checkout Playbook Repo') {
            steps {
                // Clones private repo Snaatak-Infra-Titans/Ansible.git
                // using the branch configured in the job (e.g. SCRUM-447-pawan)
                checkout scm
            }
        }

        stage('ScyllaDB Dev Playbook CI') {
            steps {
                ansiblePlaybookCI(
                    // Playbook file in Ansible/Playbook/ScyllaDB
                    playbook: 'otms-dev-scylladb.yml',
                    // Inventory path under ScyllaDB (tweak file name if needed, e.g. inventory/dev)
                    inventory: 'inventory/hosts',
                    // Optional extra vars
                    extraVars: '--extra-vars env=dev',
                    // This is EXACT directory from your screenshot
                    workingDir: 'Ansible/Playbook/ScyllaDB'
                )
            }
        }

        stage('ScyllaDB Verify Playbook CI') {
            steps {
                ansiblePlaybookCI(
                    // Second playbook in same directory
                    playbook: 'verify.yml',
                    inventory: 'inventory/hosts',
                    extraVars: '--extra-vars env=dev',
                    workingDir: 'Ansible/Playbook/ScyllaDB'
                )
            }
        }
    }

    post {
        success {
            echo 'ScyllaDB Ansible Playbook CI completed successfully.'
        }
        failure {
            echo 'ScyllaDB Ansible Playbook CI failed. Please check the logs.'
        }
    }
}
