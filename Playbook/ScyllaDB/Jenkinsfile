@Library('ansible-playbook-ci-shared-library') _

pipeline {
    agent any

    stages {

        stage('Checkout Playbook Repo') {
            steps {
                checkout scm
            }
        }

        stage('Debug ScyllaDB Workspace') {
            steps {
                sh '''
                  echo "PWD:"
                  pwd
                  echo "Listing root:"
                  ls -R
                  echo "Listing Ansible/Playbook/ScyllaDB:"
                  ls -l Ansible/Playbook/ScyllaDB || echo "ScyllaDB dir not found"
                '''
            }
        }

        stage('ScyllaDB Dev Playbook CI') {
            steps {
                ansiblePlaybookCI(
                    playbook: 'otms-dev-scylladb.yml',
                    inventory: 'inventory/hosts',
                    extraVars: '--extra-vars env=dev',
                    workingDir: 'Ansible/Playbook/ScyllaDB'
                )
            }
        }

        stage('ScyllaDB Verify Playbook CI') {
            steps {
                ansiblePlaybookCI(
                    playbook: 'verify.yml',
                    inventory: 'inventory/hosts',
                    extraVars: '--extra-vars env=dev',
                    workingDir: 'Ansible/Playbook/ScyllaDB'
                )
            }
        }
    }

    post {
        success {
            echo 'ScyllaDB Ansible Playbook CI completed successfully.'
        }
        failure {
            echo 'ScyllaDB Ansible Playbook CI failed. Please check the logs.'
        }
    }
}
