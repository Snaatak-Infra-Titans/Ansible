jenkins:

  systemMessage: "Managed by Infra Titans"

  numExecutors: 2

  mode: NORMAL

  securityRealm:
    local:
      allowsSignup: false
      users:
        - id: "{{ admin_user }}"
          password: "{{ admin_password }}"

  authorizationStrategy:
    loggedInUsersCanDoAnything:
      allowAnonymousRead: false

credentials:
  system:
    domainCredentials:
      - credentials:
          - usernamePassword:
              scope: GLOBAL
              id: github-creds
              username: "{{ github_username }}"
              password: "{{ github_token }}"
              description: GitHub Credentials
